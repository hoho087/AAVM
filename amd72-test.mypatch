+static __always_inline bool
+svm_can_defer_nested_cpuid0_exit_tail(struct kvm_vcpu *vcpu, u64 run_flags)
+{
+	struct vcpu_svm *svm = to_svm(vcpu);
+	struct vmcb_control_area *control = &svm->vmcb->control;
+
+	/*
+	 * A physical CPUID intercept is unavoidable while VMCB12 owns the
+	 * global CPUID intercept.  For a completely quiescent leaf-0 exit,
+	 * defer state that cannot have changed until the first non-leaf-0 exit.
+	 * Every event/debug/PMU corner case must take the full architectural
+	 * exit tail below.
+	 */
+	return !run_flags && is_guest_mode(vcpu) && !is_sev_es_guest(vcpu) &&
+	       control->exit_code == SVM_EXIT_CPUID &&
+	       svm->vmcb->save.rax == 0 && nrips && control->next_rip &&
+	       svm->cpuid0.valid && kvm_pmu_is_fastpath_emulation_allowed(vcpu) &&
+	       kvm_is_cpuid_allowed(vcpu) &&
+	       !(svm->vmcb->save.rflags & X86_EFLAGS_TF) &&
+	       !(vcpu->guest_debug & KVM_GUESTDBG_SINGLESTEP) &&
+	       !(control->exit_int_info & SVM_EXITINTINFO_VALID) &&
+	       !(control->event_inj & SVM_EVTINJ_VALID) &&
+	       !svm->nmi_l1_to_l2 && !svm->soft_int_injected &&
+	       !svm->awaiting_iret_completion && !svm->nmi_singlestep &&
+	       !kvm_event_needs_reinjection(vcpu) &&
+	       !kvm_is_exception_pending(vcpu) &&
+	       !vcpu->arch.nested_run_pending &&
+	       nested_svm_virtualize_tpr(vcpu) &&
+	       control->tlb_ctl == TLB_CONTROL_DO_NOTHING &&
+	       (!cpu_feature_enabled(X86_FEATURE_ERAPS) ||
+		!(control->erap_ctl & ERAP_CONTROL_CLEAR_RAP)) &&
+	       msr_write_intercepted(svm, MSR_AMD64_PERF_CNTR_GLOBAL_CTL);
+}
+
+static void svm_maybe_enable_cpuid_passthrough(struct kvm_vcpu *vcpu)
+{
+	struct vcpu_svm *svm = to_svm(vcpu);
+
+	/*
+	 * SVM has a single CPUID intercept bit, not a per-leaf bitmap.  Keep
+	 * KVM's architectural CPUID emulation through reset/firmware, then use
+	 * host-passthrough CPUID only for the non-confidential L1 VMCB.  Do not
+	 * touch VMCB02 here: nested_svm_vmcb02_recalc_intercepts() must retain
+	 * VMCB12's CPUID ownership whenever L1 requests it.
+	 */
+	if (svm->cpuid_native_armed || is_guest_mode(vcpu) ||
+	    is_sev_guest(vcpu) ||
+	    time_before(jiffies, svm->cpuid_native_deadline))
+		return;
+
+	svm->cpuid_native_armed = true;
+	svm_clr_intercept(svm, INTERCEPT_CPUID);
+}
