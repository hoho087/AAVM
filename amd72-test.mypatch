+static fastpath_t handle_fastpath_nested_cpuid0(struct kvm_vcpu *vcpu)
+{
+	struct vcpu_svm *svm = to_svm(vcpu);
+	struct vmcb_control_area *control = &svm->vmcb->control;
+
+	/*
+	 * Keep architectural corner cases on the normal handler.  In
+	 * particular, the slow path must inject #GP when CPUID faulting is
+	 * enabled, and must account for instructions in a mediated PMU.
+	 */
+	if (!svm->cpuid0.valid ||
+	    !kvm_pmu_is_fastpath_emulation_allowed(vcpu) ||
+	    !kvm_is_cpuid_allowed(vcpu) ||
+	    (svm->vmcb->save.rflags & X86_EFLAGS_TF) ||
+	    (vcpu->guest_debug & KVM_GUESTDBG_SINGLESTEP))
+		return EXIT_FASTPATH_NONE;
+
+	trace_kvm_nested_vmexit(vcpu, KVM_ISA_SVM);
+	trace_kvm_cpuid(0, kvm_ecx_read(vcpu), svm->cpuid0.eax, svm->cpuid0.ebx,
+			svm->cpuid0.ecx, svm->cpuid0.edx, true, false);
+
+	kvm_eax_write(vcpu, svm->cpuid0.eax);
+	kvm_ebx_write(vcpu, svm->cpuid0.ebx);
+	kvm_ecx_write(vcpu, svm->cpuid0.ecx);
+	kvm_edx_write(vcpu, svm->cpuid0.edx);
+
+	/*
+	 * The PMU guard above proves that no active mediated counter needs a
+	 * software instruction-retired event.  TF and KVM single-step are also
+	 * excluded, so reproduce SVM's NRIPS skip directly and avoid the generic
+	 * static-call/PMU/debug tail on this timing-sensitive leaf.
+	 */
+	svm->next_rip = control->next_rip;
+	kvm_rip_write(vcpu, control->next_rip);
+	control->int_state &= ~SVM_INTERRUPT_SHADOW_MASK;
+
+	return EXIT_FASTPATH_REENTER_GUEST;
+}
