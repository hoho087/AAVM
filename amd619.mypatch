-				clr_exception_intercept(svm, GP_VECTOR);
+//			if (!enable_vmware_backdoor)  // NIKA removed
+//				clr_exception_intercept(svm, GP_VECTOR);  // NIKA removed
 
 			/*
 			 * Free the nested guest state, unless we are in SMM.
@@ -779,10 +779,10 @@
 	svm_set_intercept_for_msr(vcpu, MSR_IA32_SYSENTER_ESP, MSR_TYPE_RW,
 				  guest_cpuid_is_intel_compatible(vcpu));
 
-	if (kvm_aperfmperf_in_guest(vcpu->kvm)) {
+//	if (kvm_aperfmperf_in_guest(vcpu->kvm)) {  // NIKA removed
 		svm_disable_intercept_for_msr(vcpu, MSR_IA32_APERF, MSR_TYPE_R);
 		svm_disable_intercept_for_msr(vcpu, MSR_IA32_MPERF, MSR_TYPE_R);
-	}
+//	}  // NIKA removed
 
 	if (kvm_cpu_cap_has(X86_FEATURE_SHSTK)) {
 		bool shstk_enabled = guest_cpu_cap_has(vcpu, X86_FEATURE_SHSTK);
@@ -1011,6 +1011,18 @@
 			svm->vmcb->control.virt_ext |= VIRTUAL_VMLOAD_VMSAVE_ENABLE_MASK;
 		}
 	}
+
+	/*
+	 * KVM-AAVM: keep firmware and the ordinary Windows kernel on KVM's
+	 * architectural CPUID model.  Once an outer Hyper-V enables EFER.SVME,
+	 * let only VMCB01 execute native CPUID.  VMCB12/02 intercept ownership
+	 * remains merged by nested_vmcb02_recalc_intercepts().
+	 */
+	if (vcpu->arch.efer & EFER_SVME)
+		svm_clr_intercept(svm, INTERCEPT_CPUID);
+	else
+		svm_set_intercept(svm, INTERCEPT_CPUID);
+
 }
 
 static void svm_recalc_intercepts(struct kvm_vcpu *vcpu)
@@ -1038,7 +1050,8 @@
 	set_dr_intercepts(svm);
 
 	set_exception_intercept(svm, PF_VECTOR);
