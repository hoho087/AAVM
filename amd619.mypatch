diff -urN a/arch/x86/kvm/svm/nested.c b/arch/x86/kvm/svm/nested.c
--- a/arch/x86/kvm/svm/nested.c
+++ b/arch/x86/kvm/svm/nested.c
@@ -1611,6 +1611,17 @@
 	struct kvm_vcpu *vcpu = &svm->vcpu;
 
 	switch (exit_code) {
+	case SVM_EXIT_CPUID:
+		/*
+		 * KVM-AAVM: consume CPUID leaf 0 in L0 for every L2.  The
+		 * architectural result comes from KVM's static CPUID table and
+		 * avoids the extra L0 -> L1 -> L0 nested-exit round trip.  Do not
+		 * gate this on L2 hypercall state: that state is false for the
+		 * Hyper-V root partition.  Every other leaf retains L1 ownership.
+		 */
+		if (kvm_rax_read(vcpu) == 0)
+			return NESTED_EXIT_HOST;
+		break;
 	case SVM_EXIT_INTR:
 	case SVM_EXIT_NMI:
 	case SVM_EXIT_NPF:
